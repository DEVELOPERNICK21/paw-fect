# Firebase Admin (same project as the React Native app)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# NextAuth (admin panel)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@pawfect.app
ADMIN_PASSWORD_HASH=

# Resend (optional — contact / waitlist emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pawfect.app
CONTACT_INBOX_EMAIL=hello@pawfect.app

# Public site URL (canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

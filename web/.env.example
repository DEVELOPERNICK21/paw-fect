FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# NextAuth (admin panel)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@pawfect.app
ADMIN_PASSWORD_HASH=$6$G1Eb5fOXbkyD6e.x$vn.S31SRGtgHxRjM993AA8xTFpk6hdTJjqjmxcxJF.qCarmDkZY/AAfUvTOhRtTMZK3vD3xF/7fTvpwYSmpDE0

# Resend (optional — contact / waitlist emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pawfect.app
CONTACT_INBOX_EMAIL=hello@pawfect.app

# Public site URL (canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Play Billing verification (Android)
GOOGLE_PLAY_PACKAGE_NAME=app.pawfect
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PLAY_SUB_CARE_PLUS_MONTHLY=care_plus_monthly
PLAY_SUB_CARE_PLUS_ANNUAL=care_plus_annual
PLAY_SUB_FAMILY_MONTHLY=family_monthly
PLAY_SUB_FAMILY_ANNUAL=family_annual

# Chatbase AI widget (marketing site only). Create an agent at https://www.chatbase.co → Deploy → Chat widget → Embed → copy chatbotId.
# Allow your production hostname in the Chatbase agent settings or the widget may not load.
# Leave NEXT_PUBLIC_CHATBASE_CHATBOT_ID unset locally if you do not need the bubble.
NEXT_PUBLIC_CHATBASE_CHATBOT_ID=
# Set to true to hide the widget even when CHATBOT_ID is set (e.g. preview deployments).
# NEXT_PUBLIC_CHATBASE_DISABLED=true
# Optional; defaults to www.chatbase.co
# NEXT_PUBLIC_CHATBASE_DOMAIN=www.chatbase.co

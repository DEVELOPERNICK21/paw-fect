# Copy to .env.vercel, fill every value, then use Vercel → Environment Variables → Import .env
# (.env.vercel is gitignored — do not commit real secrets.)
#
# Production URLs — replace with your real host (custom domain or *.vercel.app).
NEXTAUTH_URL=https://pawsoul.app
NEXT_PUBLIC_SITE_URL=https://pawsoul.app

# NextAuth — required in production (openssl rand -base64 32)
NEXTAUTH_SECRET=

# Admin credentials login (bcrypt hash for ADMIN_PASSWORD_HASH; must match bcryptjs)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Firebase Admin (same project as the app)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_INBOX_EMAIL=

# Google Play Billing (optional for web)
GOOGLE_PLAY_PACKAGE_NAME=app.pawfect
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PLAY_SUB_CARE_PLUS_MONTHLY=care_plus_monthly
PLAY_SUB_CARE_PLUS_ANNUAL=care_plus_annual
PLAY_SUB_FAMILY_MONTHLY=family_monthly
PLAY_SUB_FAMILY_ANNUAL=family_annual

# Chatbase (optional)
NEXT_PUBLIC_CHATBASE_CHATBOT_ID=

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Marketing / website collections — client SDK denied; Next.js uses Admin SDK only.
    match /pricing_plans/{planId} {
      allow read, write: if false;
    }
    match /contact_submissions/{id} {
      allow read, write: if false;
    }
    match /waitlist/{id} {
      allow read, write: if false;
    }
    match /site_content/{docId} {
      allow read, write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Pets collection
      match /pets/{petId} {
        allow read, write: if isOwner(userId);

        // Smart schedule records
        match /healthRecords/{recordId} {
          allow read, write: if isOwner(userId);
        }

        // Manual logs added by user
        match /manualHealthRecords/{recordId} {
          allow read, write: if isOwner(userId);
        }

        // Smart schedule history
        match /healthRecordHistory/{historyId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
  }
}